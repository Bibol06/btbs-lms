{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectLmsBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::btbs-lms-media-506546664509-eu-north-1"
    },
    {
      "Sid": "ManageLmsMediaObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": [
        "arn:aws:s3:::btbs-lms-media-506546664509-eu-north-1/_staging/*",
        "arn:aws:s3:::btbs-lms-media-506546664509-eu-north-1/_s3/*"
      ]
    }
  ]
}
